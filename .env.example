# NamoID Hosted Auth Configuration (TEST Environment)
NAMOID_CLIENT_ID=test_client_id_placeholder
NAMOID_CLIENT_SECRET=test_client_secret_placeholder
NAMOID_REDIRECT_URI=http://localhost:8000/auth/callback
NAMOID_ENV=test

# Application Session & Database
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars
DATABASE_URL=sqlite:///./grantgate.db
AUTH_MODE=mock
DEMO_MODE=true

# Optional AI Narrator Configuration
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=claude-3-7-sonnet-latest

# ServiceNow SecOps Integration & Webhook Configuration
SERVICENOW_ENABLED=true
SERVICENOW_INSTANCE_URL=https://dev-secops.service-now.com
SERVICENOW_WEBHOOK_URL=
SERVICENOW_MOCK_MODE=true
